{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loot-tracker-window",
  "description": "Permissions for the Loot Tracker overlay window (PoE 2; local app content only, no remote URLs).",
  "windows": ["loot-tracker"],
  "local": true,
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-size"
  ]
}
